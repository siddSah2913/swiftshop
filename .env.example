# SwiftShop — copy this file to .env and fill in real values.
# NEVER commit .env (it holds secrets). This file is the safe template.

# PostgreSQL connection string (local Docker: see PROGRESS.md "PostgreSQL in Docker")
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/swiftshop?schema=public"

# NextAuth v5 secret — generate with: npx auth secret
AUTH_SECRET="generate-me"

# Public URL for dev
AUTH_URL="http://localhost:3000"

# Khalti (sandbox) — get from https://sandbox.khalti.com/
KHALTI_SECRET_KEY=""

# eSewa (sandbox) — get from https://epay.sandbox.nic.np/
ESEWA_MERCHANT_CODE=""
ESEWA_SECRET_KEY=""